{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Exceptions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithExceptionDetails"
    ]
  },
  "BearerTokenSettings": {
    "Issuer": "Qalaat-Al-Dhaman",
    "SecretKey": "",
    "Audience": "Qalaat-Al-Dhaman",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationMinutes": 43800
  },
  "SeqUrl": "",
  "AdminData": {
    "Username": "",
    "Password": ""
  }
}
